# Database (PostgreSQL 17 everywhere; leave DATABASE_URL blank in local dev to auto-start data/postgres on 127.0.0.1:54329)
DATABASE_URL=
POSTGRES_DB=onechapter
POSTGRES_USER=onechapter
ONECHAPTER_PG_PORT=54329

# Django settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.onechapter.am
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.onechapter.am

# Telegram bot (@one_chapter_bot)
TELEGRAM_BOT_TOKEN=

# Access & Identity (invite | public)
ONECHAPTER_ACCESS_MODE=invite
ONECHAPTER_ALLOWED_TELEGRAM_IDS=
ONECHAPTER_INVITE_CODE=
ONECHAPTER_REQUIRE_WEB_LOGIN=0
ONECHAPTER_PUBLIC_URL=http://127.0.0.1:43147

# Defaults for new readers
ONECHAPTER_TIMEZONE=Asia/Yerevan
ONECHAPTER_DELIVERY=08:00

# AWS S3 storage (eu-north-1 only)
AWS_REGION=eu-north-1
ONECHAPTER_S3_BUCKET=
