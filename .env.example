# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=

# Where the app stores the database, uploads, and settings.
# Defaults to ./data in this repository.
ONECHAPTER_DATA=

# Bind address for the local reader.
ONECHAPTER_HOST=127.0.0.1
ONECHAPTER_PORT=43147

# Public URL of this reader, used in Telegram messages.
# Leave empty to use http://HOST:PORT
ONECHAPTER_PUBLIC_URL=

# Default timezone for new readers (IANA name).
ONECHAPTER_TIMEZONE=Asia/Yerevan

# Django. Defaults are fine for the local reader.
# Set DJANGO_DEBUG=0 only if you already set a long DJANGO_SECRET_KEY.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
