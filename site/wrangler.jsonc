{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Public static landing site for onechapter.am (ADR 0001 & ADR 0002).
  "name": "onechapter-landing",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "onechapter.am",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
